<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Library | Home</title>

  <style>

    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: Arial, sans-serif;
    }

    body {
      background: #f5f7fa;
      color: #222;
    }

    /* TOP BAR */

    .topbar {
      background: #12355b;
      color: white;
      padding: 8px 6%;
      font-size: 14px;
      display: flex;
      justify-content: space-between;
    }

    /* HEADER */

    header {
      background: white;
      padding: 18px 6%;
      display: flex;
      align-items: center;
      justify-content: space-between;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

    .logo {
      display: flex;
      align-items: center;
      gap: 15px;
    }

    .logo-icon {
      font-size: 45px;
    }

    .logo h1 {
      color: #12355b;
      font-size: 25px;
    }

    .logo p {
      color: #777;
      font-size: 14px;
      margin-top: 4px;
    }

    /* NAVIGATION */

    nav a {
      text-decoration: none;
      color: #333;
      margin-left: 25px;
      font-weight: 600;
    }

    nav a:hover {
      color: #c47b00;
    }

    /* HERO */

    .hero {
      background:
        linear-gradient(rgba(18,53,91,0.85), rgba(18,53,91,0.85)),
        url("https://images.unsplash.com/photo-1507842217343-583bb7270b66");

      background-size: cover;
      background-position: center;

      padding: 90px 20px;
      text-align: center;
      color: white;
    }

    .hero h2 {
      font-size: 42px;
      margin-bottom: 15px;
    }

    .hero p {
      font-size: 18px;
      margin-bottom: 30px;
    }

    .search-button {
      display: inline-block;
      background: #e19a22;
      color: white;
      text-decoration: none;
      padding: 14px 30px;
      border-radius: 6px;
      font-weight: bold;
    }

    .search-button:hover {
      background: #c47b00;
    }

    /* QUICK LINKS */

    .section {
      padding: 55px 6%;
    }

    .section-title {
      text-align: center;
      color: #12355b;
      font-size: 30px;
      margin-bottom: 35px;
    }

    .cards {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .card {
      background: white;
      padding: 30px 20px;
      text-align: center;
      border-radius: 8px;
      box-shadow: 0 3px 12px rgba(0,0,0,0.08);
    }

    .card-icon {
      font-size: 38px;
      margin-bottom: 15px;
    }

    .card h3 {
      color: #12355b;
      margin-bottom: 10px;
    }

    .card p {
      color: #666;
      font-size: 14px;
      line-height: 1.5;
    }

    /* INFO */

    .info {
      background: #12355b;
      color: white;
      padding: 45px 6%;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 30px;
      text-align: center;
    }

    .info h3 {
      margin-bottom: 10px;
      color: #e19a22;
    }

    /* FOOTER */

    footer {
      background: #0b243d;
      color: white;
      text-align: center;
      padding: 25px;
      font-size: 14px;
    }

    /* MOBILE */

    @media(max-width: 800px) {

      header {
        flex-direction: column;
        gap: 20px;
      }

      nav a {
        margin: 8px;
        display: inline-block;
      }

      .hero h2 {
        font-size: 30px;
      }

      .cards {
        grid-template-columns: 1fr 1fr;
      }

      .info {
        grid-template-columns: 1fr;
      }
    }

    @media(max-width: 500px) {

      .cards {
        grid-template-columns: 1fr;
      }

      .topbar {
        flex-direction: column;
        text-align: center;
        gap: 5px;
      }

    }

  </style>
</head>


<body>


<!-- TOP BAR -->

<div class="topbar">

  <span>📚 Library Services</span>

  <span>Library Timings: 9:00 AM – 8:00 PM</span>

</div>


<!-- HEADER -->

<header>

  <div class="logo">

    <div class="logo-icon">📚</div>

    <div>

      <h1>YOUR INSTITUTION LIBRARY</h1>

      <p>Knowledge • Learning • Research</p>

    </div>

  </div>


  <nav>

    <a href="index.html">Home</a>

    <a href="#catalogue">Catalogue</a>

    <a href="#services">Services</a>

    <a href="#about">About</a>

    <a href="#contact">Contact</a>

  </nav>

</header>


<!-- HERO -->

<section class="hero">

  <h2>Welcome to Our Library</h2>

  <p>
    Explore books, resources and knowledge from our library collection.
  </p>

  <a class="search-button" href="#catalogue">
    🔎 Search Library Collection
  </a>

</section>


<!-- QUICK LINKS -->

<section class="section" id="catalogue">

  <h2 class="section-title">
    Library Resources
  </h2>


  <div class="cards">


    <div class="card">

      <div class="card-icon">📚</div>

      <h3>Books</h3>

      <p>
        Search and explore books available in the library.
      </p>

    </div>


    <div class="card">

      <div class="card-icon">📖</div>

      <h3>Reference</h3>

      <p>
        Access reference books and special collections.
      </p>

    </div>


    <div class="card">

      <div class="card-icon">💻</div>

      <h3>E-Resources</h3>

      <p>
        Explore electronic books, journals and databases.
      </p>

    </div>


    <div class="card">

      <div class="card-icon">📰</div>

      <h3>New Arrivals</h3>

      <p>
        Discover newly added books and resources.
      </p>

    </div>


  </div>

</section>


<!-- SERVICES -->

<section class="section" id="services">

  <h2 class="section-title">
    Library Services
  </h2>


  <div class="cards">

    <div class="card">

      <div class="card-icon">🔄</div>

      <h3>Issue & Return</h3>

      <p>
        Information about book issue and return services.
      </p>

    </div>


    <div class="card">

      <div class="card-icon">🖥️</div>

      <h3>Digital Library</h3>

      <p>
        Access digital resources and online services.
      </p>

    </div>


    <div class="card">

      <div class="card-icon">🔍</div>

      <h3>Research Support</h3>

      <p>
        Library assistance for academic and research work.
      </p>

    </div>


    <div class="card">

      <div class="card-icon">👨‍💼</div>

      <h3>Ask Librarian</h3>

      <p>
        Contact the library team for assistance.
      </p>

    </div>

  </div>

</section>


<!-- INFORMATION -->

<section class="info" id="about">

  <div>

    <h3>📍 Library</h3>

    <p>
      Your Institution Name<br>
      Your City, Maharashtra
    </p>

  </div>


  <div>

    <h3>⏰ Opening Hours</h3>

    <p>
      Monday – Saturday<br>
      9:00 AM – 8:00 PM
    </p>

  </div>


  <div id="contact">

    <h3>📞 Contact</h3>

    <p>
      library@example.com<br>
      +91 XXXXX XXXXX
    </p>

  </div>

</section>


<!-- FOOTER -->

<footer>

  © 2026 Your Institution Library.
  All Rights Reserved.

</footer>


</body>

</html>
